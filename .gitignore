# Local environment and secrets — never commit these.
.env
.env.*
!.env.example

# Local backup output (see scripts/backup.sh). Prefer a location outside the
# project entirely; this entry only protects against accidental placement here.
backups/
*.dump
*.sql.gz
*.tar.gz

# Build output and IDE state.
build/
.gradle/
.kotlin/
.android/
kotlin-errors.log
.idea/
*.iml
local.properties

# Backend local state.
backend-api/vendor/
backend-api/node_modules/
backend-api/storage/app/private/*
!backend-api/storage/app/private/.gitignore
backend-api/database/*.sqlite*
backend-api/.phpunit.result.cache

# Admin website local state.
admin-web/node_modules/
admin-web/dist/
admin-web/tsconfig.tsbuildinfo

# Operating system noise.
.DS_Store
Thumbs.db
