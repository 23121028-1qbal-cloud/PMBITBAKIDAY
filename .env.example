# Template for the root .env used by docker-compose.yml.
# Copy to .env and replace every value with a local-only secret:
#
#   cp .env.example .env
#   chmod 600 .env
#
# Generate passwords with, for example: openssl rand -base64 24
# The real .env must never be committed, shared, or reused in production.

# --- MySQL (official project database) ------------------------------------
# Port published on 127.0.0.1 of the host. Laravel runs on the host, so
# backend-api/.env must use DB_HOST=127.0.0.1 and DB_PORT equal to this value.
MYSQL_FORWARD_PORT=3306

MYSQL_DATABASE=pmb_itb_akiday
MYSQL_USER=pmb_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- Retired MariaDB from Tahap 11 (profile: legacy-mariadb) ---------------
# Kept only for recovery of the old volume. Not used by the application.
# LEGACY_* prefix: the plain DB_* names are read by Laravel itself, so a shell
# that sourced this file would override the application's real database config.
LEGACY_DB_FORWARD_PORT=3307

LEGACY_DB_DATABASE=pmb_itb_akiday
LEGACY_DB_USERNAME=pmb_app
LEGACY_DB_PASSWORD=
LEGACY_DB_ROOT_PASSWORD=
